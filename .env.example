document.addEventListener("DOMContentLoaded", () => {
  const pageType = document.body.dataset.pageType;

  document.querySelectorAll(".primary-btn, .secondary-btn, .nav-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const href = button.getAttribute("href");
      if (href) {
        window.location.href = href;
      }
    });
  });

  if (pageType === "dashboard") {
    loadDashboard();
  }
});

async function loadDashboard() {
  try {
    const response = await fetch("/api/metrics");
    if (!response.ok) {
      throw new Error("Metrics request failed");
    }

    const data = await response.json();
    renderSummary(data.summary);
    renderServices(data.services);
    renderAlerts(data.alerts);
    renderIncidents(data.incidents);
  } catch (error) {
    console.error("Dashboard load error:", error);
    const summaryGrid = document.getElementById("summary-grid");
    if (summaryGrid) {
      summaryGrid.innerHTML = '<div class="stat-card"><div class="label">System</div><div class="value">Offline</div><div class="trend">Unable to load telemetry</div></div>';
    }
  }
}

function renderSummary(summary) {
  const container = document.getElementById("summary-grid");
  if (!container) return;

  const cards = [
    { label: "Healthy", value: summary.healthy_services, trend: "+8.4% vs last hour" },
    { label: "Warnings", value: summary.warning_services, trend: "2 require review" },
    { label: "Critical", value: summary.critical_services, trend: "1 active incident" },
    { label: "MTTR", value: "19m", trend: "-4.2 min improvement" },
  ];

  container.innerHTML = cards
    .map(
      (card) => `
        <div class="stat-card">
          <div class="label">${card.label}</div>
          <div class="value">${card.value}</div>
          <div class="trend">${card.trend}</div>
        </div>
      `
    )
    .join("");
}

function renderServices(services) {
  const container = document.getElementById("services-table");
  if (!container) return;

  container.innerHTML = `
    <table class="service-table">
      <thead>
        <tr>
          <th>Service</th>
          <th>Latency</th>
          <th>Error</th>
          <th>Throughput</th>
          <th>Region</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        ${services
          .map(
            (service) => `
              <tr>
                <td>${service.name}</td>
                <td>${service.latency_ms} ms</td>
                <td>${service.error_rate.toFixed(2)}%</td>
                <td>${service.throughput}</td>
                <td>${service.region}</td>
                <td><span class="status-pill status-${service.status}">${service.status}</span></td>
              </tr>
            `
          )
          .join("")}
      </tbody>
    </table>
  `;
}

function renderAlerts(alerts) {
  const container = document.getElementById("alerts-list");
  if (!container) return;

  container.innerHTML = alerts
    .map(
      (alert) => `
        <div class="alert-item">
          <div class="alert-meta">
            <strong>${alert.service}</strong>
            <span>${alert.message}</span>
          </div>
          <span class="status-pill status-${alert.severity === "high" ? "critical" : alert.severity === "medium" ? "warning" : "healthy"}">${alert.severity}</span>
        </div>
      `
    )
    .join("");
}

function renderIncidents(incidents) {
  const container = document.getElementById("incidents-list");
  if (!container) return;

  container.innerHTML = incidents
    .map(
      (incident) => `
        <div class="incident-item">
          <div class="incident-meta">
            <strong>${incident.summary}</strong>
            <span>${incident.service} • ${incident.impact}</span>
          </div>
          <span class="status-pill status-${incident.status.toLowerCase().includes("mitig") ? "warning" : incident.status.toLowerCase().includes("invest") ? "critical" : "healthy"}">${incident.status}</span>
        </div>
      `
    )
    .join("");
}
